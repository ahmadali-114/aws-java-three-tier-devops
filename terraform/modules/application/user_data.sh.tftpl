#!/bin/bash
set -euo pipefail

readonly AWS_REGION="${aws_region}"
readonly MASTER_SECRET_ARN="${rds_master_secret_arn}"
readonly APPLICATION_SECRET_ARN="${application_secret_arn}"
readonly RDS_ENDPOINT="${rds_endpoint}"
readonly RDS_PORT="${rds_port}"
readonly REPOSITORY_URL="${repository_url}"
readonly REPOSITORY_BRANCH="${repository_branch}"
readonly APP_ROOT="/opt/java-3tier"

dnf update -y
dnf install -y git java-17-amazon-corretto-devel jq mariadb105 maven tomcat9 unzip

rm -rf "$APP_ROOT"
git clone --depth 1 --branch "$REPOSITORY_BRANCH" "$REPOSITORY_URL" "$APP_ROOT"

MASTER_SECRET_JSON=$(aws secretsmanager get-secret-value \
  --secret-id "$MASTER_SECRET_ARN" \
  --region "$AWS_REGION" \
  --query SecretString \
  --output text)
MASTER_USERNAME=$(jq -r '.username' <<< "$MASTER_SECRET_JSON")
MASTER_PASSWORD=$(jq -r '.password' <<< "$MASTER_SECRET_JSON")

APPLICATION_SECRET_JSON=$(aws secretsmanager get-secret-value \
  --secret-id "$APPLICATION_SECRET_ARN" \
  --region "$AWS_REGION" \
  --query SecretString \
  --output text 2>/dev/null || true)

if [ -z "$APPLICATION_SECRET_JSON" ] || [ "$APPLICATION_SECRET_JSON" = "None" ]; then
  APPLICATION_USERNAME="javaapp"
  APPLICATION_PASSWORD=$(openssl rand -hex 24)

  mariadb --ssl -h "$RDS_ENDPOINT" -P "$RDS_PORT" -u "$MASTER_USERNAME" --password="$MASTER_PASSWORD" javaapp < "$APP_ROOT/database/schema.sql"
  mariadb --ssl -h "$RDS_ENDPOINT" -P "$RDS_PORT" -u "$MASTER_USERNAME" --password="$MASTER_PASSWORD" <<SQL
CREATE USER IF NOT EXISTS '$APPLICATION_USERNAME'@'%' IDENTIFIED BY '$APPLICATION_PASSWORD';
ALTER USER '$APPLICATION_USERNAME'@'%' IDENTIFIED BY '$APPLICATION_PASSWORD';
GRANT SELECT, INSERT, UPDATE, DELETE ON javaapp.* TO '$APPLICATION_USERNAME'@'%';
FLUSH PRIVILEGES;
SQL

  APPLICATION_SECRET_JSON=$(jq -cn \
    --arg username "$APPLICATION_USERNAME" \
    --arg password "$APPLICATION_PASSWORD" \
    '{username: $username, password: $password}')
  aws secretsmanager put-secret-value \
    --secret-id "$APPLICATION_SECRET_ARN" \
    --region "$AWS_REGION" \
    --secret-string "$APPLICATION_SECRET_JSON" \
    --output text >/dev/null
fi

APPLICATION_USERNAME=$(jq -r '.username' <<< "$APPLICATION_SECRET_JSON")
APPLICATION_PASSWORD=$(jq -r '.password' <<< "$APPLICATION_SECRET_JSON")

cat > /etc/java-3tier.env <<EOF
DB_URL=jdbc:mysql://$RDS_ENDPOINT:$RDS_PORT/javaapp?sslMode=REQUIRED
DB_USERNAME=$APPLICATION_USERNAME
DB_PASSWORD=$APPLICATION_PASSWORD
EOF
chmod 0600 /etc/java-3tier.env

install -d -m 0755 /etc/systemd/system/tomcat9.service.d
cat > /etc/systemd/system/tomcat9.service.d/java-3tier.conf <<EOF
[Service]
EnvironmentFile=/etc/java-3tier.env
EOF

cd "$APP_ROOT/Java-Login-App"
mvn --batch-mode clean package -DskipTests

rm -f /var/lib/tomcat9/webapps/ROOT /var/lib/tomcat9/webapps/ROOT.war
cp target/dptweb-1.0.war /var/lib/tomcat9/webapps/ROOT.war

systemctl daemon-reload
systemctl enable tomcat9
systemctl restart tomcat9
